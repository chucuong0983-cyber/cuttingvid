#!/bin/bash
# Streamer CuttingVid (Mac) - 1 cua so: dan link / chon file, tick lua chon, bam 1 nut.
export PATH="$HOME/Library/Application Support/StreamerCuttingVid/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
CONF="$HOME/Library/Application Support/StreamerCuttingVid"
mkdir -p "$CONF"
VER="1.31"
TITLE="CuttingVid by Louis Chu  ·  v$VER"
ICON="$RES/AppIcon.icns"

msg() {
osascript - "$1" "$TITLE" <<'EOF' >/dev/null 2>&1
on run argv
  display dialog (item 1 of argv) with title (item 2 of argv) buttons {"OK"} default button "OK" with icon caution
end run
EOF
}
confirm_exit() {
osascript - "$TITLE" <<'EOF' 2>/dev/null
on run argv
  set r to display dialog "Bạn có chắc muốn thoát app không?" with title (item 1 of argv) buttons {"Thoát", "Không"} default button "Không"
  return button returned of r
end run
EOF
}
confirm_install() {
osascript - "$TITLE" <<'EOF' 2>/dev/null
on run argv
  set r to display dialog "Máy chưa có yt-dlp hoặc ffmpeg.

Bấm Cài đặt để tự cài (khoảng 5–15 phút, có thể phải nhập mật khẩu máy Mac). Cài xong thì mở lại app." with title (item 1 of argv) buttons {"Để sau", "Cài đặt"} default button "Cài đặt"
  return button returned of r
end run
EOF
}
in_terminal() {
osascript - "$1" <<'EOF' >/dev/null 2>&1
on run argv
  tell application "Terminal"
    activate
    do script (item 1 of argv)
  end tell
end run
EOF
}
to_sec() { # "1:15:00" / "15:00" (dau - o dau se bo) -> giay; sai thi rong
  local s="${1//[[:space:]]/}"; s="${s#-}"
  if [[ "$s" =~ ^([0-9]{1,3}):([0-9]{1,2}):([0-9]{1,2})$ ]]; then
    echo $((10#${BASH_REMATCH[1]} * 3600 + 10#${BASH_REMATCH[2]} * 60 + 10#${BASH_REMATCH[3]}))
  elif [[ "$s" =~ ^([0-9]{1,3}):([0-9]{1,2})$ ]]; then
    echo $((10#${BASH_REMATCH[1]} * 60 + 10#${BASH_REMATCH[2]}))
  fi
}
is_local() { [[ "$1" != http* ]] && [ -n "$1" ] && [ -f "$1" ]; }

# ---------- Kiem tra ----------
if ! command -v yt-dlp >/dev/null || ! command -v ffmpeg >/dev/null; then
  r=$(confirm_install)
  [ "$r" = "Cài đặt" ] && in_terminal "bash $(printf '%q' "$RES/install.sh")"
  exit 0
fi
if [ -f "$CONF/running" ] && kill -0 "$(cat "$CONF/running" 2>/dev/null)" 2>/dev/null; then
  msg "Đang có một lượt tải / cắt chạy. Đợi lượt đó xong (hoặc đóng cửa sổ Terminal của nó) rồi hãy làm tiếp, để YouTube không chặn."
  exit 0
fi

# ---------- Tu cap nhat yt-dlp moi tuan (chay ngam) ----------
last=$(cat "$CONF/last_update" 2>/dev/null || echo 0)
if [ $(( $(date +%s) - ${last:-0} )) -gt 604800 ]; then
  date +%s > "$CONF/last_update"
  (yt-dlp -U >/dev/null 2>&1 &)
fi

# ---------- Tu cap nhat tu GitHub: chi can tat app mo lai ----------
REPO="https://raw.githubusercontent.com/chucuong0983-cyber/cuttingvid/main"
APPC="$(cd "$(dirname "$0")/.." && pwd)"
newer() { # $1 moi hon $2 ?
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | awk -F. '{printf "%05d%05d%05d %s\n",$1,$2,$3,$0}' | sort | tail -n1 | cut -d' ' -f2)" = "$1" ]
}
UPDMSG=""
remote=$(curl -fsS --max-time 4 "$REPO/version.txt" 2>/dev/null | tr -d '[:space:]')
if [[ "$remote" =~ ^[0-9]+(\.[0-9]+)*$ ]] && newer "$remote" "$VER" && [ -w "$APPC" ]; then
  tmp=$(mktemp -d); ok=1
  list=$(curl -fsS --max-time 5 "$REPO/mac/files.txt" 2>/dev/null) || ok=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in *..*|/*) ok=0; break;; esac
    mkdir -p "$tmp/$(dirname "$f")"
    curl -fsS --max-time 120 "$REPO/mac/$f" -o "$tmp/$f" 2>/dev/null || { ok=0; break; }
  done <<< "$list"
  if [ $ok = 1 ] && [ -n "$list" ]; then
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      mkdir -p "$APPC/$(dirname "$f")"; cp "$tmp/$f" "$APPC/$f.new" && mv -f "$APPC/$f.new" "$APPC/$f"   # mv: file moi, luot dang chay van dung file cu
      case "$f" in MacOS/*|*.sh) chmod +x "$APPC/$f";; esac
    done <<< "$list"
    rm -rf "$tmp"
    export CV_UPDATED="$remote"
    exec "$APPC/MacOS/StreamerCuttingVid"
  fi
  rm -rf "$tmp"
fi
[ -n "$CV_UPDATED" ] && UPDMSG="Đã tự cập nhật lên v$CV_UPDATED."

# ---------- Cua so chinh: exec de chinh app hien tren Dock (logo, ghim duoc) ----------
exec osascript -l JavaScript "$RES/app.js" "$RES" "$CONF" "$TITLE" "$ICON" "$UPDMSG"
